[Unit]
Description=Rebuild and publish desktopcolors.com (dump scores, build, atomic swap)
After=network.target counter.service
Wants=counter.service

[Service]
Type=oneshot
User=desktopcolors
Group=desktopcolors
WorkingDirectory=/opt/desktopcolors
Environment=REPO_DIR=/opt/desktopcolors
Environment=WWW_DIR=/var/www/desktopcolors
Environment=DB_PATH=/var/lib/desktopcolors/counter.db
Environment=COUNTER_BIN=/opt/desktopcolors/counter/counter
# npm ci fails without a writable HOME (its cache defaults under $HOME/.npm).
# Set explicitly rather than relying on systemd deriving HOME from the passwd
# entry. GOCACHE/GOMODCACHE are deliberately NOT set here: rebuild.sh itself
# defaults both under $REPO_DIR/.cache so the unit and the documented manual
# `sudo -u desktopcolors bash ...` invocation agree on one location instead of
# each falling back to a different cache and duplicating ~360 MB of modules.
# PATH is still needed here: Go is installed to /usr/local/go and put on PATH
# by /etc/profile.d/go.sh, but that is only sourced by login shells, and this
# unit runs bash as a non-login shell — so without prepending
# /usr/local/go/bin, `go` resolves nowhere against systemd's default service
# PATH and the build exits 127.
Environment=HOME=/opt/desktopcolors
Environment=PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash /opt/desktopcolors/deploy/rebuild.sh
# Build + publish needs to write the release dir and the repo's node_modules/dist.
# /var/lib/desktopcolors is included so `counter dump` can open the SQLite DB
# (WAL creates -wal/-shm files) even if ProtectSystem=strict is added later.
ReadWritePaths=/var/www/desktopcolors /opt/desktopcolors /var/lib/desktopcolors
