---
import { loadCatalog } from "../lib/loadCatalog";
import { getGitInfo } from "../lib/gitInfo";

const catalog = await loadCatalog();
const colorCount = catalog.colors.length;
const platformCount = catalog.osList.length;
const year = new Date().getFullYear();
const git = getGitInfo();

const browseLinks = [
  { label: "All platforms", href: "/" },
  { label: "Color Explorer", href: "/explorer" },
  { label: "Setup Guide", href: "/setup" },
];
const projectLinks = [
  { label: "About", href: "/about" },
  // TODO(owner): point at the public repo once it exists.
  { label: "Source on GitHub", href: git.repoUrl ?? "#" },
  { label: "Suggest a platform", href: "mailto:hello@desktopcolors.com?subject=Suggest%20a%20platform" },
];
const legalLinks = [
  { label: "Privacy Notice", href: "/privacy" },
  { label: "Imprint", href: "/imprint" },
];
---
<footer class="dc-footer">
  <!-- MOBILE (< 760px) -->
  <div class="dc-footer-narrow">
    <div>
      <div style="font: 700 18px var(--font-ui); letter-spacing: -0.4px; color: var(--ink);">desktopcolors<span style="color: var(--faint);">.com</span></div>
      <p style="font: 400 13px var(--font-ui); line-height: 1.6; color: #78716c; margin: 8px 0 0;">The archive of every solid desktop background color shipped by classic operating systems.</p>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 22px 16px;">
      <div>
        <div style="font: 500 10px var(--font-mono); color: var(--faint); letter-spacing: 1.5px; margin-bottom: 11px;">BROWSE</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {browseLinks.map((l) => (<a class="dc-foot-link" href={l.href} style="font: 400 14px var(--font-ui); color: var(--muted);">{l.label}</a>))}
        </div>
      </div>
      <div>
        <div style="font: 500 10px var(--font-mono); color: var(--faint); letter-spacing: 1.5px; margin-bottom: 11px;">LEGAL</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {legalLinks.map((l) => (<a class="dc-foot-link" href={l.href} style="font: 400 14px var(--font-ui); color: var(--muted);">{l.label}</a>))}
          <a class="dc-foot-link" href="/about" style="font: 400 14px var(--font-ui); color: var(--muted);">About</a>
        </div>
      </div>
    </div>
    {git.hash && (
      git.url ? (
        <a class="dc-foot-link" href={git.url} title="View this build" style="display: inline-flex; align-items: center; gap: 8px; font: 500 12px var(--font-mono); color: #78716c;">
          <span style="color: oklch(0.5 0.15 150);">{git.hash}</span>
          <span style="color: #d6d3d1;">·</span>
          <span>{git.date}</span>
        </a>
      ) : (
        <div style="display: inline-flex; align-items: center; gap: 8px; font: 500 12px var(--font-mono); color: #78716c;">
          <span style="color: oklch(0.5 0.15 150);">{git.hash}</span>
          <span style="color: #d6d3d1;">·</span>
          <span>{git.date}</span>
        </div>
      )
    )}
    <div style="border-top: 1px solid var(--card-border); padding-top: 16px; font: 400 11px var(--font-mono); color: var(--faint);">© {year} desktopcolors.com · {colorCount} colors archived</div>
  </div>

  <!-- DESKTOP (>= 760px) -->
  <div class="dc-footer-wide">
    <div class="dc-page-x" style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 32px; padding-block: 44px 34px;">
      <div>
        <div style="font: 700 18px var(--font-ui); letter-spacing: -0.4px; color: var(--ink);">desktopcolors<span style="color: var(--faint);">.com</span></div>
        <p style="font: 400 13px var(--font-ui); line-height: 1.6; color: #78716c; margin: 12px 0 0; max-width: 280px;">The archive of every solid desktop background color shipped by classic operating systems.</p>
        {git.hash && (
          <>
            <div style="margin-top: 20px; font: 400 12px var(--font-mono); color: var(--faint);">
              <span style="color: oklch(0.6 0.14 150);">~</span> <span style="color: #cbc7c1;">$</span> git rev-parse HEAD
            </div>
            {git.url ? (
              <a class="dc-foot-link" href={git.url} title="View this build" style="display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; font: 500 13px var(--font-mono); color: #78716c;">
                <span style="color: oklch(0.5 0.15 150);">{git.hash}</span>
                <span style="color: #d6d3d1;">·</span>
                <span>{git.date}</span>
                <span style="color: #d6d3d1;">·</span>
                <span>{git.branch}</span>
              </a>
            ) : (
              <div style="display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; font: 500 13px var(--font-mono); color: #78716c;">
                <span style="color: oklch(0.5 0.15 150);">{git.hash}</span>
                <span style="color: #d6d3d1;">·</span>
                <span>{git.date}</span>
                <span style="color: #d6d3d1;">·</span>
                <span>{git.branch}</span>
              </div>
            )}
          </>
        )}
      </div>
      <div>
        <div style="font: 500 11px var(--font-mono); color: var(--faint); letter-spacing: 1.5px; margin-bottom: 14px;">BROWSE</div>
        <div style="display: flex; flex-direction: column; gap: 11px;">
          {browseLinks.map((l) => (<a class="dc-foot-link" href={l.href} style="font: 400 14px var(--font-ui); color: var(--muted);">{l.label}</a>))}
        </div>
      </div>
      <div>
        <div style="font: 500 11px var(--font-mono); color: var(--faint); letter-spacing: 1.5px; margin-bottom: 14px;">PROJECT</div>
        <div style="display: flex; flex-direction: column; gap: 11px;">
          {projectLinks.map((l) => (<a class="dc-foot-link" href={l.href} style="font: 400 14px var(--font-ui); color: var(--muted);">{l.label}</a>))}
        </div>
      </div>
      <div>
        <div style="font: 500 11px var(--font-mono); color: var(--faint); letter-spacing: 1.5px; margin-bottom: 14px;">LEGAL</div>
        <div style="display: flex; flex-direction: column; gap: 11px;">
          {legalLinks.map((l) => (<a class="dc-foot-link" href={l.href} style="font: 400 14px var(--font-ui); color: var(--muted);">{l.label}</a>))}
        </div>
      </div>
    </div>
    <div class="dc-page-x" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 16px; border-top: 1px solid var(--card-border);">
      <span style="font: 400 12px var(--font-mono); color: var(--faint);">© {year} desktopcolors.com · a labor of nostalgia</span>
      <span style="font: 400 12px var(--font-mono); color: var(--faint);">{colorCount} colors · {platformCount} platforms archived</span>
    </div>
  </div>
</footer>

<style>
  .dc-footer { background: var(--bg); border-top: 1px solid var(--hairline); }
  /* Separate viewport designs, keyed to the site-wide 760px breakpoint used
     across tokens.css (Header, mobile-parity rules). */
  .dc-footer-wide { display: none; }
  /* Layout lives on the class (not inline) so the media query can toggle
     display without losing to inline-style specificity. */
  .dc-footer-narrow { display: flex; flex-direction: column; gap: 22px; padding: 30px 22px 26px; }
  @media (min-width: 760px) {
    .dc-footer-wide { display: block; }
    .dc-footer-narrow { display: none; }
  }
  /* Inline styles can't express :hover, so footer links opt in here. */
  .dc-foot-link { transition: color 0.12s ease; }
  .dc-foot-link:hover { color: var(--accent-strong) !important; }
</style>
