---
import Base from "../layouts/Base.astro";

// TODO(owner): replace the [bracketed] placeholders with the real operator
// identity and address. These are legally required (§ 5 TMG / § 18 MStV) and
// must be accurate before the site goes live in Germany.
const blocks = [
  { label: "OPERATOR", dot: "#008080", value: "[Your Name]\ndesktopcolors.com" },
  { label: "ADDRESS", dot: "#3a6ea5", value: "[Street & Number]\n[Postal Code] [City]\nGermany" },
  { label: "CONTACT", dot: "#808000", value: "hello@desktopcolors.com" },
  { label: "RESPONSIBLE FOR CONTENT", dot: "#800080", value: "[Your Name], address as above\n(§ 18 Abs. 2 MStV)" },
];
---
<Base title="Imprint — desktopcolors.com" description="Legally required operator details for desktopcolors.com.">
  <!-- HERO -->
  <div class="dc-page-x dc-page-head" style="padding-block-end: 30px;">
    <div style="max-width: 720px;">
      <div class="dc-page-eyebrow">IMPRINT · ANGABEN GEMÄSS § 5 TMG</div>
      <h1 class="dc-page-title">Who's behind this archive.</h1>
      <p class="dc-page-lead">A one-person project, run from Germany. The legally required details live below — the story is over on <a href="/about" style="color: var(--accent-strong); border-bottom: 1px solid currentColor;">About</a>.</p>
    </div>
  </div>

  <div class="dc-page-x"><hr class="dc-rule" /></div>

  <!-- BODY -->
  <div class="dc-page-x" style="padding-block: 40px 20px;">
    <div style="max-width: 900px;">
      <div style="background: var(--panel); border: 1px solid var(--card-border); border-radius: 16px; overflow: hidden;">
        {blocks.map((b, i) => (
          <div class="dc-legal-row" style={`display: grid; gap: 24px; padding: 24px 28px; border-top: ${i === 0 ? "none" : "1px solid #f0eeec"}; align-items: start;`}>
            <div style="display: flex; align-items: center; gap: 11px;">
              <span style={`width: 12px; height: 12px; border-radius: 4px; background-color: ${b.dot}; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12);`}></span>
              <div style="font: 500 12px var(--font-mono); color: #8a847c; letter-spacing: 1px;">{b.label}</div>
            </div>
            <div style="font-size: 15px; line-height: 1.65; color: var(--ink); white-space: pre-line;">{b.value}</div>
          </div>
        ))}
      </div>

      <!-- LIABILITY -->
      <div style="margin-top: 22px; padding: 22px 26px; background: #f6f7f7; border: 1px solid var(--card-border); border-radius: 16px;">
        <div style="font: 600 10px var(--font-mono); color: #8a847c; letter-spacing: 1.2px;">HAFTUNGSHINWEIS · DISCLAIMER</div>
        <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin: 10px 0 0; text-wrap: pretty;">Despite careful review, we assume no liability for the content of external links; their operators are solely responsible. Platform names, logos, and color values are catalogued for reference and remain the property of their respective owners. This archive is an independent, non-commercial project and is not affiliated with or endorsed by any operating-system vendor.</p>
      </div>
    </div>
  </div>
  <div style="height: 40px;"></div>

  <style>
    .dc-legal-row { grid-template-columns: 1fr; }
    @media (min-width: 860px) { .dc-legal-row { grid-template-columns: 220px 1fr; } }
  </style>
</Base>
